---
import logo from '../assets/brand/logo.svg';
import { navItems } from '../data/site';

const { current, overlay = false } = Astro.props;
---

<header class:list={['site-header', overlay && 'site-header--overlay']} id="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="泽锐 zerui 首页" data-aria-en="ZERUI home">
      <img
        class="brand-logo"
        src={logo.src}
        width="34"
        height="26"
        alt="ZERUI 泽锐"
        loading="eager"
        decoding="async"
      />
      <span class="brand-cn" data-en="ZERUI">泽锐</span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            class="nav-item"
            href={item.href}
            data-en={item.en}
            aria-current={current === item.href ? 'page' : undefined}
          >
            {item.zh}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button class="lang-btn" id="lang-toggle" type="button" aria-pressed="false" aria-label="Switch language">
        EN
      </button>
      <a
        class="btn btn-solid btn-sm"
        data-wa="quote"
        href="https://wa.me/8617853993611"
        target="_blank"
        rel="noopener"
        data-en="Get a Quote">获取报价</a
      >
      <button
        class="menu-btn"
        id="menu-btn"
        type="button"
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="打开菜单"
        data-aria-en="Open menu"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>
