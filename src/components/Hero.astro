---
import { getHeroSources } from '../lib/hero-images';

const { desktopAvif, desktopWebp, mobileAvif, mobileWebp } = await getHeroSources();
---

<section class="hero hero-photo" aria-labelledby="hero-title">
  <div class="hero-media" aria-hidden="true">
    <picture>
      <source
        media="(max-width: 900px)"
        type="image/avif"
        srcset={mobileAvif.srcSet.attribute}
        sizes="100vw"
      />
      <source
        media="(max-width: 900px)"
        type="image/webp"
        srcset={mobileWebp.srcSet.attribute}
        sizes="100vw"
      />
      <source type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes="100vw" />
      <img
        src={desktopWebp.src}
        width={desktopWebp.attributes.width}
        height={desktopWebp.attributes.height}
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-photo-img"
      />
    </picture>
    <div class="hero-scrim"></div>
  </div>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow" data-en="Outdoor Kitchen Manufacturer · OEM / ODM">
        OUTDOOR KITCHEN MANUFACTURER · OEM / ODM
      </p>

      <h1 id="hero-title">
        <span class="h1-line" data-en="Professional Outdoor">专业户外厨房</span>
        <span class="h1-line brass" data-en="Kitchen Manufacturer">制造商</span>
      </h1>

      <p
        class="lede"
        data-en="Stainless steel outdoor kitchens, made in our own factory. Built to your site and market, with OEM options."
      >
        不锈钢户外厨房，自有工厂制造。按场地与市场定制，可做 OEM。
      </p>

      <div class="cta-row">
        <a
          class="btn btn-solid"
          data-wa="quote"
          href="https://wa.me/8617853993611"
          target="_blank"
          rel="noopener"
          data-en="Request a Proposal">获取定制方案</a
        >
        <a class="btn btn-line" href="/factory/" data-en="Tour the Factory">参观工厂与工艺</a>
      </div>
    </div>
  </div>
</section>
