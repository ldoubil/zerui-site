---
const { blocks } = Astro.props;
let h2Index = 0;
const items = blocks.map((block) => {
  if (block.type === 'h2') {
    h2Index += 1;
    return { ...block, id: `s${h2Index}` };
  }
  return block;
});
---

<div class="article-body">
  {
    items.map((block) => {
      if (block.type === 'h2') {
        return (
          <h2 id={block.id} data-en={block.en}>
            {block.zh}
          </h2>
        );
      }
      if (block.type === 'p') {
        return <p data-en={block.en}>{block.zh}</p>;
      }
      if (block.type === 'ul') {
        return (
          <ul>
            {block.items.map((item) => (
              <li data-en={item.en}>{item.zh}</li>
            ))}
          </ul>
        );
      }
      if (block.type === 'ol') {
        return (
          <ol>
            {block.items.map((item) => (
              <li data-en={item.en}>{item.zh}</li>
            ))}
          </ol>
        );
      }
      if (block.type === 'table') {
        return (
          <div class="table-scroll">
            <table class="spec-table">
              <thead>
                <tr>
                  {block.head.map((cell) => (
                    <th data-en={cell.en}>{cell.zh}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {block.rows.map((row) => (
                  <tr>
                    {row.map((cell) => (
                      <td data-en={cell.en}>{cell.zh}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        );
      }
      return <p class="note" data-en={block.en}>{block.zh}</p>;
    })
  }
</div>
