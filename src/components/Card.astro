---
const { labelZh, labelEn, titleZh, titleEn, descZh, descEn, wide } = Astro.props;
---

<article class="card">
  <div class:list={['ph', wide && 'ph-wide']} aria-hidden="true">
    <span data-en="Image Placeholder">图片占位</span>
  </div>
  <div class="card-body">
    <p class="card-label" data-en={labelEn}>{labelZh}</p>
    <h2 class="card-title" data-en={titleEn}>{titleZh}</h2>
    <p class="card-desc" data-en={descEn}>{descZh}</p>
  </div>
</article>
