---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import InquiryCard from '../../components/InquiryCard.astro';
import { images } from '../../lib/images';
import { pods } from '../../data/pods';

export function getStaticPaths() {
  return pods.map((pod) => ({
    params: { slug: pod.slug },
    props: { pod },
  }));
}

const { pod } = Astro.props;
const relatedPods = pod.related
  .map((slug) => pods.find((item) => item.slug === slug))
  .filter(Boolean);
---

<Layout
  path={`/product/${pod.slug}/`}
  current="/products/"
  titleZh={`${pod.nameZh}｜泽锐 zerui 户外厨房`}
  titleEn={`${pod.nameEn} | ZERUI Outdoor Kitchens`}
  descZh={pod.leadZh}
  descEn={pod.leadEn}
>
  <section class="section">
    <div class="wrap">
      <div class="pd-hero">
        <div class="pd-media">
          <Image
            src={images[pod.image]}
            alt={pod.altZh}
            data-alt-en={pod.altEn}
            widths={[640, 1000, 1400]}
            sizes="(max-width: 900px) 100vw, 50vw"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="pd-copy">
          <a class="pd-back" href="/products/" data-en="← Back to the collection">
            ← 返回收藏
          </a>
          <p class="pod-full">{pod.fullEn}</p>
          <p class="eyebrow" data-en={pod.seriesEn}>{pod.seriesZh}</p>
          <h1 class="pd-title" data-en={`${pod.nameEn} Outdoor Kitchen Pod`}>
            {pod.nameZh} 户外厨房舱
          </h1>
          <p class="pd-lead" data-en={pod.leadEn}>{pod.leadZh}</p>
          <ul class="pd-features">
            {
              pod.featuresZh.map((feature, index) => (
                <li>
                  <span class="tick">✓</span>
                  <span data-en={pod.featuresEn[index]}>{feature}</span>
                </li>
              ))
            }
          </ul>
          <p
            class="pd-note"
            data-en="From 1 unit · 20-day standard production · Configuration confirmed before order"
          >
            1 件起订 · 标准生产 20 天 · 下单前确认配置
          </p>
          <a class="btn btn-solid" href="#inquiry" data-en="Request configuration & quote ↗">
            获取配置与报价 ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--pale">
    <div class="wrap">
      <div class="editorial">
        <h2 data-en="Specification & configuration">规格与配置</h2>
      </div>
      <div class="table-scroll pd-specs">
        <table class="spec-table spec-table--spec">
          <tbody>
            {
              pod.specs.map((spec) => (
                <tr>
                  <th scope="row">
                    <span data-en={spec.labelEn}>{spec.labelZh}</span>
                  </th>
                  <td>
                    <span data-en={spec.valueEn}>{spec.valueZh}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="editorial editorial--after">
        {
          pod.asideZh && (
            <p class="pd-aside" data-en={pod.asideEn}>
              {pod.asideZh}
            </p>
          )
        }
        {
          pod.bodyZh.map((paragraph, index) => (
            <p data-en={pod.bodyEn[index]}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-en="EXPLORE FURTHER">继续浏览</p>
          <h2 class="section-title" data-en="You may also like.">你可能也喜欢。</h2>
        </div>
      </div>
      <div class="pod-grid pod-grid--related">
        {
          relatedPods.map((item) => (
            <a class="pod-card" href={`/product/${item.slug}/`}>
              <div class="pod-media">
                <Image
                  src={images[item.image]}
                  alt={item.altZh}
                  data-alt-en={item.altEn}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 760px) 100vw, 33vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="pod-copy">
                <p class="pod-full">{item.fullEn}</p>
                <span class="eyebrow" data-en={item.seriesEn}>{item.seriesZh}</span>
                <h3 class="pod-name" data-en={item.nameEn}>{item.nameZh}</h3>
                <span class="pod-link" data-en="Explore configuration ↗">探索配置 ↗</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <InquiryCard
        eyebrowZh="这台舱体"
        eyebrowEn="THIS POD"
        titleZh="让这台舱，适合你的项目。"
        titleEn="Make this pod fit your project."
        descZh="发来场地条件与目标市场，我们按你的配置确认尺寸、设备与出运方案。"
        descEn="Send your site conditions and target market; we will confirm dimensions, equipment and shipping for your configuration."
      />
    </div>
  </section>
</Layout>
