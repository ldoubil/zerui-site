---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import InquiryCard from '../../components/InquiryCard.astro';
import { images } from '../../lib/images';
import { pods } from '../../data/pods';

export function getStaticPaths() {
  return pods.map((pod) => ({
    params: { slug: pod.slug },
    props: { pod },
  }));
}

const { pod } = Astro.props;
const relatedPods = pod.related
  .map((slug) => pods.find((item) => item.slug === slug))
  .filter(Boolean);

const metaTitlesEn: Record<string, string> = {
  obsidian: 'Obsidian Integrated Outdoor Kitchen Pod with Lift-Up Canopy | ZERUI',
  lumiere: 'Lumière Courtyard Outdoor Kitchen Pod | ZERUI',
  'copper-studio': 'Copper Studio Outdoor Kitchen & Entertainment Pod | ZERUI',
  'chef-edition': 'Chef Edition Flagship Outdoor Kitchen Pod | ZERUI',
  'mirror-edition': 'Mirror Edition Architectural Outdoor Kitchen Pod | ZERUI',
};
const titleEn = metaTitlesEn[pod.slug] ?? `${pod.nameEn} Outdoor Kitchen Pod | ZERUI`;

const siteOrigin = Astro.site ?? new URL('https://zeruioutdoor.com');
const pageUrl = new URL(`/product/${pod.slug}/`, siteOrigin).href;
const imageUrl = new URL(images[pod.image].src, siteOrigin).href;

const deliverySpecs = [
  {
    labelZh: '40HQ 装柜量',
    labelEn: '40HQ container load',
    valueZh: '12–24 台，视型号与包装',
    valueEn: '12–24 pods, depending on model and packing',
  },
  {
    labelZh: '台面',
    labelEn: 'Countertop',
    valueZh: '烧结石、石英石或不锈钢，按配置',
    valueEn: 'Sintered stone, quartz or stainless steel, to configuration',
  },
  {
    labelZh: '保修',
    labelEn: 'Warranty',
    valueZh: '1 年，提供备件',
    valueEn: '1 year, spare parts available',
  },
];

const jsonLd = [
  {
    '@type': 'Product',
    name: pod.fullEn,
    alternateName: `${pod.nameZh} ${pod.fullEn}`,
    description: pod.leadEn,
    image: [imageUrl],
    sku: `ZERUI-${pod.slug.toUpperCase()}`,
    brand: { '@type': 'Brand', name: 'ZERUI' },
    manufacturer: { '@type': 'Organization', name: 'ZERUI' },
    material: '304 stainless steel',
    url: pageUrl,
    additionalProperty: pod.specs.map((spec) => ({
      '@type': 'PropertyValue',
      name: spec.labelEn,
      value: spec.valueEn,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteOrigin).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Outdoor Kitchens',
        item: new URL('/products/', siteOrigin).href,
      },
      { '@type': 'ListItem', position: 3, name: pod.nameEn, item: pageUrl },
    ],
  },
];

// 只用于 head 的 meta description，避免为压长度而改动正文 lead
const META_DESC_EN = {
  obsidian:
    'Obsidian outdoor kitchen pod: dark finish, lift-up canopy, grill station, sink, storage and cold space — built for modern courtyards and dealer showrooms.',
  lumiere:
    'Lumière courtyard kitchen pod: light finish, perimeter lighting and a clean cooking zone for villas, terraces and outdoor dining. Dimensions on request.',
  'copper-studio':
    'Copper Studio outdoor kitchen: warm metal tones and wood-grain cabinets, an expressive entertainment unit with screen, grill, sink and fridge options.',
  'mirror-edition':
    'Mirror Edition outdoor kitchen: reflective metal and contemporary cabinetry give a strong architectural presence, with cooking and prep integrated.',
};
const metaDescEn = META_DESC_EN[pod.slug] ?? pod.leadEn;
---

<Layout
  path={`/product/${pod.slug}/`}
  current="/products/"
  titleZh={`${pod.nameZh}｜ZERUI`}
  titleEn={titleEn}
  descZh={pod.leadZh}
  descEn={metaDescEn}
  ogImage={imageUrl}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="wrap">
      <div class="pd-hero">
        <div class="pd-media">
          <Image
            src={images[pod.image]}
            alt={pod.altZh}
            data-alt-en={pod.altEn}
            widths={[640, 1000, 1400]}
            sizes="(max-width: 900px) 100vw, 50vw"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="pd-copy">
          <a class="pd-back" href="/products/" data-en="← Back to the collection">
            ← 返回收藏
          </a>
          <p class="pod-full">{pod.fullEn}</p>
          <p class="eyebrow" data-en={pod.seriesEn}>{pod.seriesZh}</p>
          <h1 class="pd-title" data-en={`${pod.nameEn} Outdoor Kitchen Pod`}>
            {pod.nameZh} 户外厨房舱
          </h1>
          <p class="pd-lead" data-en={pod.leadEn}>{pod.leadZh}</p>
          <ul class="pd-features">
            {
              pod.featuresZh.map((feature, index) => (
                <li>
                  <span class="tick">✓</span>
                  <span data-en={pod.featuresEn[index]}>{feature}</span>
                </li>
              ))
            }
          </ul>
          <p
            class="pd-note"
            data-en="From 1 unit · 20-day standard production · Configuration confirmed before order"
          >
            1 件起订 · 标准生产 20 天 · 下单前确认配置
          </p>
          <a class="btn btn-solid" href="#inquiry" data-en="Request configuration & quote ↗">
            获取配置与报价 ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--pale">
    <div class="wrap">
      <div class="editorial">
        <h2 data-en="Specification & configuration">规格与配置</h2>
      </div>
      <div class="table-scroll pd-specs">
        <table class="spec-table spec-table--spec">
          <tbody>
            {
              pod.specs.map((spec) => (
                <tr>
                  <th scope="row">
                    <span data-en={spec.labelEn}>{spec.labelZh}</span>
                  </th>
                  <td>
                    <span data-en={spec.valueEn}>{spec.valueZh}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="table-scroll pd-specs">
        <table class="spec-table spec-table--spec">
          <tbody>
            {
              deliverySpecs.map((spec) => (
                <tr>
                  <th scope="row">
                    <span data-en={spec.labelEn}>{spec.labelZh}</span>
                  </th>
                  <td>
                    <span data-en={spec.valueEn}>{spec.valueZh}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="pd-download">
        <a
          class="btn btn-line"
          href={`/specs/${pod.slug}-outdoor-kitchen-spec-sheet.pdf`}
          download
          data-en="Download spec sheet (PDF)"
        >
          下载规格表（PDF）
        </a>
      </p>
      <p class="pd-resources">
        <span data-en="Project resources:">项目资料：</span>
        <a href="/resources/installation/" data-en="installation checklist">安装清单</a>
        <span aria-hidden="true">·</span>
        <a href="/resources/shipping/" data-en="export packing & shipping">包装与运输</a>
        <span aria-hidden="true">·</span>
        <a href="/resources/compliance/" data-en="compliance & certification">合规与认证</a>
        <span aria-hidden="true">·</span>
        <a href="/projects/" data-en="dealer & distributor program">经销商计划</a>
      </p>
      <div class="editorial editorial--after">
        {
          pod.asideZh && (
            <p class="pd-aside" data-en={pod.asideEn}>
              {pod.asideZh}
            </p>
          )
        }
        {
          pod.bodyZh.map((paragraph, index) => (
            <p data-en={pod.bodyEn[index]}>{paragraph}</p>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow" data-en="EXPLORE FURTHER">继续浏览</p>
          <h2 class="section-title" data-en="You may also like.">你可能也喜欢。</h2>
        </div>
      </div>
      <div class="pod-grid pod-grid--related">
        {
          relatedPods.map((item) => (
            <a class="pod-card" href={`/product/${item.slug}/`}>
              <div class="pod-media">
                <Image
                  src={images[item.image]}
                  alt={item.altZh}
                  data-alt-en={item.altEn}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 760px) 100vw, 33vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="pod-copy">
                <p class="pod-full">{item.fullEn}</p>
                <span class="eyebrow" data-en={item.seriesEn}>{item.seriesZh}</span>
                <h3 class="pod-name" data-en={item.nameEn}>{item.nameZh}</h3>
                <span class="pod-link" data-en="Explore configuration ↗">探索配置 ↗</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <InquiryCard
        eyebrowZh="这台舱体"
        eyebrowEn="THIS POD"
        titleZh="让这台舱，适合你的项目。"
        titleEn="Make this pod fit your project."
        descZh="发来场地条件与目标市场，我们按你的配置确认尺寸、设备与出运方案。"
        descEn="Send your site conditions and target market; we will confirm dimensions, equipment and shipping for your configuration."
      />
    </div>
  </section>
</Layout>
