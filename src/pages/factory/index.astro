---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import InquiryCard from '../../components/InquiryCard.astro';
import { images } from '../../lib/images';

const workshopImages = [
  {
    image: images.factoryLine,
    captionZh: '整机装配',
    captionEn: 'Assembly',
    noteZh: '整机在厂内完成装配与出货前检查，按项目逐台核对配置。',
    noteEn: 'Units are assembled and checked before dispatch, with each configuration verified against the project.',
    altZh: '工厂内装配完成的户外厨房整机',
    altEn: 'Finished outdoor kitchens assembled on the factory floor',
  },
  {
    image: images.factoryWeld,
    captionZh: '细节与收边',
    captionEn: 'Details & finishing',
    noteZh: '焊缝、收边与柜体配合在出厂前逐项检查。',
    noteEn: 'Welds, edges and cabinet fits are checked item by item before dispatch.',
    altZh: '不锈钢烧烤炉与柜体的收边细节',
    altEn: 'Close-up of stainless steel grill and cabinet detailing',
  },
  {
    image: images.factoryPack,
    captionZh: '出口包装',
    captionEn: 'Export packing',
    noteZh: '整机检查后按运输方式装入木箱，随箱附编号与装箱清单。',
    noteEn: 'After inspection, units are packed into timber crates with numbered packing lists.',
    altZh: '工厂内用木箱包装的户外厨房',
    altEn: 'Outdoor kitchens packed in timber export crates at the factory',
  },
];
---

<Layout
  path="/factory/"
  current="/factory/"
  titleZh="工厂与工艺｜泽锐 zerui 户外厨房制造"
  titleEn="Factory & Craft | ZERUI Outdoor Kitchen Manufacturing"
  descZh="走进泽锐 zerui 位于山东临沂的自有工厂：2000 ㎡ 厂房、60+ 人团队、月产能 200+ 件，2019 年成立，钣金、焊接、装配与出口包装全部内部完成。"
  descEn="Inside ZERUI's own factory in Linyi, Shandong: a 2,000 m² facility, a team of 60+ and capacity of 200+ units per month, established in 2019 with fabrication, assembly and export packing all in-house."
>
  <PageHero
    eyebrowZh="FACTORY / CRAFT"
    eyebrowEn="FACTORY / CRAFT"
    titleZh="从一张板，到一台能直接用的厨房"
    titleEn="From a sheet of steel to a kitchen that arrives ready"
    ledeZh="山东临沂，自有工厂。从钣金、焊接、表面处理到装配与出口包装，全部内部完成。"
    ledeEn="Our own factory in Linyi, Shandong. Sheet metal, welding, finishing, assembly and export packing all completed in-house."
  >
    <div class="page-hero-meta">
      <span data-en="Established 2019">2019 年成立</span>
      <span data-en="Linyi, Shandong">山东临沂</span>
      <span data-en="Export packing">出口包装</span>
    </div>
  </PageHero>

  <section class="band-section">
    <div class="wrap">
      <div class="stat-band">
        <div class="stat">
          <p class="stat-value">2019</p>
          <p class="stat-label" data-en="Established">成立</p>
        </div>
        <div class="stat">
          <p class="stat-value">
            2,000
            <span class="stat-unit" data-en="m²">㎡</span>
          </p>
          <p class="stat-label" data-en="Factory floor">厂房面积</p>
        </div>
        <div class="stat">
          <p class="stat-value">
            60
            <span class="stat-unit">+</span>
          </p>
          <p class="stat-label" data-en="Team">团队</p>
        </div>
        <div class="stat">
          <p class="stat-value">
            200
            <span class="stat-unit">+</span>
          </p>
          <p class="stat-label" data-en="Units per month">件每月</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <p
        class="lede lede--wide"
        data-en="Every unit starts as flat sheet and leaves as a finished kitchen. Between those two points, the work stays in one building: cutting, bending, welding, finishing, assembly and packing, each reviewed before the next step begins."
      >
        每一台厨房从平板开始，到最后作为整机出货，中间全部在同一栋厂房里完成：开料、折弯、
        焊接、表面处理、装配与包装，每一步确认后再进入下一步。
      </p>
    </div>
  </section>

  {
    workshopImages.map((item) => (
      <section class="section section--tight">
        <div class="wrap">
          <figure class="factory-plate">
            <div class="factory-plate-media">
              <Image
                src={item.image}
                alt={item.altZh}
                data-alt-en={item.altEn}
                widths={[800, 1400, 2000]}
                sizes="100vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              <span class="factory-plate-title" data-en={item.captionEn}>{item.captionZh}</span>
              <span class="factory-plate-note" data-en={item.noteEn}>{item.noteZh}</span>
            </figcaption>
          </figure>
        </div>
      </section>
    ))
  }

  <section class="section section--tight">
    <div class="wrap">
      <InquiryCard
        eyebrowZh="VISIT / SAMPLE"
        eyebrowEn="VISIT / SAMPLE"
        titleZh="想看看实物或来工厂"
        titleEn="See a unit or visit the factory"
        descZh="可以安排看样或到厂参观，也可以先发图纸，我们按你的配置给出工厂端的建议。"
        descEn="We can arrange a sample review or a factory visit, or start from your drawings and advise on the manufacturing side."
        secondaryLabelZh="了解定制流程"
        secondaryLabelEn="See the custom process"
        secondaryHref="/custom/"
      />
    </div>
  </section>
</Layout>
