---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import MediaBand from '../../components/MediaBand.astro';
import InquiryCard from '../../components/InquiryCard.astro';
import { images } from '../../lib/images';
import { categories } from '../../data/site';

export function getStaticPaths() {
  return categories.map((item) => ({
    params: { category: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;

// 只用于 head 的 meta description，避免为压长度而改动正文 intro
const META_DESC_EN = {
  islands:
    'Outdoor kitchen islands manufacturer: countertop, cabinets, cooking equipment and storage built as one unit, assembled and checked before shipment.',
  modular:
    'Modular outdoor kitchen systems: cabinets, worktops and equipment ship flat as independent modules, suited to narrow access and phased builds.',
  grills:
    'Outdoor grill manufacturer for stainless steel built-in and freestanding models, with body, grates and lid combined around how you cook.',
  cabinets:
    'Stainless steel outdoor kitchen cabinets: doors, drawers, sink and corner units for adding storage, replacing doors or fitting out a project in bulk.',
};
const META_DESC_ZH = {
  islands:
    '户外厨房岛台制造商：台面、柜体、设备与收纳做成一个整体，出厂前完成装配与检查，到场按图就位。',
  grills:
    '户外烧烤炉制造商：嵌入式与独立式不锈钢炉体，炉身、炉排与上盖按你的烹饪方式组合。',
};
// 关键词对齐：SEO 标题与 H1 单独覆盖，导航仍用 item.titleZh/titleEn
const HEAD = {
  islands: {
    titleZh: '户外厨房岛台制造商｜ZERUI',
    titleEn: 'Outdoor Kitchen Islands Manufacturer | ZERUI',
    h1Zh: '户外厨房岛台制造商',
    h1En: 'Outdoor Kitchen Islands Manufacturer',
  },
  modular: {
    titleZh: '模块化户外厨房系统｜ZERUI',
    titleEn: 'Modular Outdoor Kitchen Systems | ZERUI',
    h1Zh: '模块化户外厨房系统',
    h1En: 'Modular Outdoor Kitchen Systems',
  },
  grills: {
    titleZh: '户外烧烤炉制造商｜ZERUI',
    titleEn: 'Outdoor Grill Manufacturer: Built-In & Freestanding | ZERUI',
    h1Zh: '户外烧烤炉制造商',
    h1En: 'Outdoor Grill Manufacturer',
  },
  cabinets: {
    titleZh: '不锈钢户外厨房柜体｜ZERUI',
    titleEn: 'Stainless Steel Outdoor Kitchen Cabinets | ZERUI',
    h1Zh: '不锈钢户外厨房柜体',
    h1En: 'Stainless Steel Outdoor Kitchen Cabinets',
  },
};
const head = HEAD[item.slug] ?? {
  titleZh: `${item.titleZh}｜ZERUI`,
  titleEn: `${item.titleEn} | ZERUI Outdoor Kitchens`,
  h1Zh: item.titleZh,
  h1En: item.titleEn,
};
---

<Layout
  path={`/products/${item.slug}/`}
  current="/products/"
  titleZh={head.titleZh}
  titleEn={head.titleEn}
  descZh={META_DESC_ZH[item.slug] ?? `${item.introZh} 尺寸、布局、台面与设备均可按项目定制。`}
  descEn={META_DESC_EN[item.slug] ?? `${item.introEn} Dimensions, layout, countertop and equipment are made to project.`}
>
  <PageHero
    eyebrowZh={`PRODUCT / ${item.no}`}
    eyebrowEn={`PRODUCT / ${item.no}`}
    titleZh={head.h1Zh}
    titleEn={head.h1En}
    ledeZh={item.introZh}
    ledeEn={item.introEn}
  >
    <div class="page-hero-meta">
      <span data-en="Made to project">按项目定制</span>
      <span data-en="Dimensions adjustable">尺寸可调</span>
      <span data-en="OEM available">支持 OEM</span>
    </div>
  </PageHero>

  <MediaBand
    image={images[item.image]}
    altZh={item.altZh}
    altEn={item.altEn}
    captionZh="结构与柜体细节"
    captionEn="Structure and cabinet detail"
  />

  <section class="section">
    <div class="wrap">
      <div class="split split--text">
        <div class="split-copy">
          <p class="eyebrow" data-en="WHERE IT WORKS">适用场景</p>
          <h2 class="section-title" data-en="Suited to these settings">适合这些场地</h2>
          <p class="lede" style="margin-top:18px;" data-en={item.shortEn}>{item.shortZh}</p>
          <p class="note" data-en={item.noteEn}>{item.noteZh}</p>
        </div>
        <div>
          <ul class="plain-list">
            {
              item.useCases.map((useCase, index) => (
                <li>
                  <span class="idx">{String(index + 1).padStart(2, '0')}</span>
                  <span data-en={useCase.en}>{useCase.zh}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="section-title" data-en="Structure & options">结构与可定制项</h2>
        <span class="section-note" data-en="Per drawing">按图纸确认</span>
      </div>
      <div class="split">
        <div>
          <p class="eyebrow" data-en="FORMS">结构形式</p>
          <ul class="plain-list">
            {
              item.forms.map((form, index) => (
                <li>
                  <span class="idx">{String(index + 1).padStart(2, '0')}</span>
                  <span data-en={form.en}>{form.zh}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="eyebrow" data-en="OPTIONS">可定制项</p>
          <ul class="plain-list">
            {
              item.options.map((option, index) => (
                <li>
                  <span class="idx">{String(index + 1).padStart(2, '0')}</span>
                  <span data-en={option.en}>{option.zh}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="split split--wide">
        <div class="split-copy">
          <p class="eyebrow" style="color:var(--brass-light);" data-en="EQUIPMENT">可集成设备</p>
          <h2 class="section-title" data-en="Built around the equipment you choose">
            围绕你选的设备来做
          </h2>
          <p class="lede" style="margin-top:20px;" data-en={item.equipEn}>{item.equipZh}</p>
        </div>
        <div class="split-media">
          <p
            class="lede"
            style="margin-top:0;"
            data-en="We can work from your equipment list, or reserve cut-outs for items supplied later. Cut-out sizes and service routes are confirmed on the drawings before production."
          >
            可以按你已有的设备清单来做，也可以先预留开孔，设备之后再补。开孔尺寸与管线位置在
            生产前随图纸一起确认。
          </p>
          <div class="cta-row">
            <a class="btn btn-ghost" href="/custom/" data-en="Custom & OEM">定制与 OEM</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <InquiryCard
        eyebrowZh="THIS FORM"
        eyebrowEn="THIS FORM"
        titleZh="这类结构适合你的项目吗？"
        titleEn="Is this form right for your project?"
        descZh="发来场地照片与大致尺寸，我们可以先判断结构形式，再给出配置与报价方向。"
        descEn="Send a site photo and rough dimensions; we can suggest a structural form first, then a configuration and pricing direction."
      />
    </div>
  </section>
</Layout>
