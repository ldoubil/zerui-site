---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import InquiryCard from '../../components/InquiryCard.astro';
import { faqGroups } from '../../data/faq';
import { SITE } from '../../data/site';

const total = faqGroups.reduce((sum, group) => sum + group.items.length, 0);

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${SITE.origin}/faq/#faq`,
  mainEntity: faqGroups.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q.zh,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a.zh,
      },
    }))
  ),
};
---

<Layout
  path="/faq/"
  current="/faq/"
  titleZh="常见问题｜ZERUI"
  titleEn="FAQ | ZERUI Outdoor Kitchens"
  descZh="关于户外厨房定制、报价、起订量、排期、物流、安装与售后的常见问题。答案给出条件与处理方式，不做绝对承诺。"
  descEn="Common questions about custom outdoor kitchens, quotes, minimum quantities, scheduling, shipping, installation and after-sales — answered with conditions rather than promises."
  jsonLd={[faqPage]}
>
  <PageHero
    eyebrowZh="FAQ"
    eyebrowEn="FAQ"
    titleZh="先把常见问题说清楚"
    titleEn="The questions that come up most"
    ledeZh="按主题分组，答案尽量给出条件与处理方式，而不是一句「没问题」。涉及价格、数量与排期的内容，以报价与书面确认为准。"
    ledeEn="Grouped by topic, with answers that state conditions and process rather than a blanket “no problem”. Anything involving price, quantity or scheduling is confirmed at quotation and in writing."
  >
    <div class="page-hero-meta">
      <span data-en={`${total} questions`}>{total} 个问题</span>
      <span data-en="5 groups">5 个分组</span>
      <span data-en="Conditions stated">给条件，不给承诺</span>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap faq-layout">
      <nav class="faq-nav" aria-label="问题分组">
        {
          faqGroups.map((group, index) => (
            <a href={`#group-${group.id}`}>
              <span data-en={group.title.en}>{group.title.zh}</span>
              <span>{String(index + 1).padStart(2, '0')}</span>
            </a>
          ))
        }
      </nav>

      <div>
        {
          faqGroups.map((group) => (
            <section class="faq-group" id={`group-${group.id}`}>
              <h2 data-en={group.title.en}>{group.title.zh}</h2>
              <div class="faq-list">
                {group.items.map((item, index) => (
                  <div class="faq-item" id={item.id} data-q-en={item.q.en} data-a-en={item.a.en}>
                    <h3 class="faq-q">
                      <span class="idx">{String(index + 1).padStart(2, '0')}</span>
                      <span data-en={item.q.en}>{item.q.zh}</span>
                    </h3>
                    <p class="faq-a" data-en={item.a.en}>{item.a.zh}</p>
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <InquiryCard
        eyebrowZh="STILL UNSURE"
        eyebrowEn="STILL UNSURE"
        titleZh="问题不在上面？"
        titleEn="Not answered above?"
        descZh="直接发消息说明你的情况，我们会按项目给具体回答，而不是复制一段通用说法。"
        descEn="Send a message about your situation; we answer against the project rather than copying a generic reply."
      />
    </div>
  </section>
</Layout>
